# 企业微信配置
BOT_ID=你的机器人ID
SECRET=你的机器人密钥

# 和风天气API配置
HEFENG_API_KEY=你的和风天气API密钥
# 多城市配置（watchdog 模式，逗号分隔的 slug=locationID）
CITY_SLUGS=baotou=101080201,huhehaote=101080101
CITY_NAMES=baotou=包头,huhehaote=呼和浩特
# 雨/雪提前量（小时），供 precip_soon_in 规则使用，默认 3
ALERT_LEAD_HOURS=3
# 以下兼容旧单城市模式（未配置 CITY_SLUGS 时回退）
CITY_ID=101080101
CITY_NAME=呼和浩特

# 定时推送配置
SCHEDULE_TIME=08:00
SCHEDULE_CHAT_ID=推送目标群聊ID
SCHEDULE_CHAT_TYPE=2

# LLM API 配置 (统一接口)
LLM_API_KEY=你的LLM API密钥
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-turbo
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1000
